{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "License": {
    "Issuer": "ModuPOS",
    "Audience": "ModuPOS",
    "ExpectedInstallationId": "YOUR-INSTALLATION-GUID",
    "PublicKeyPem": "",
    "Token": ""
  },
  "Jwt": {
    "Issuer": "ModuPOS",
    "Audience": "ModuPOS.Api",
    "PrivateKeyPem": "",
    "AllowEphemeralKey": false,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "Lockout": {
      "MaxFailures": 5,
      "WindowMinutes": 15,
      "LockMinutes": 15
    },
    "SignInRateLimitPerMinute": 20
  }
}
